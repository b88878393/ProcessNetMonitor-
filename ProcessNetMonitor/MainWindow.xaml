<Window x:Class="ProcessNetMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ProcessNetMonitor.ViewModels"
        mc:Ignorable="d"
        Title="Process &amp; Network Monitor" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Restart as Administrator" Command="{Binding RestartAsAdminCommand}" />
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Dark Theme" IsCheckable="True" IsChecked="{Binding IsDarkTheme}" />
                <MenuItem Header="_Auto Refresh" IsCheckable="True" IsChecked="{Binding AutoRefresh}" />
                <MenuItem Header="Refresh _Interval">
                    <MenuItem Header="500ms" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="500" />
                    <MenuItem Header="1 second" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="1000" />
                    <MenuItem Header="2 seconds" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="2000" />
                    <MenuItem Header="5 seconds" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="5000" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>
        
        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="5">
            <TabItem Header="Processes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search/Filter Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="300" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Search by name, PID, port (:8080 or port:8080), path, command line"/>
                        <Button Content="Clear" Command="{Binding ClearFilterCommand}" Margin="5,0"/>
                        <CheckBox Content="Tree View" IsChecked="{Binding ShowTreeView}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="Kill Process" Command="{Binding KillProcessCommand}" Margin="10,0,0,0"/>
                        <Button Content="Kill Tree" Command="{Binding KillTreeCommand}" Margin="5,0"/>
                        <Button Content="Suspend" Command="{Binding SuspendProcessCommand}" Margin="5,0"/>
                        <Button Content="Resume" Command="{Binding ResumeProcessCommand}" Margin="5,0"/>
                        <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}" Margin="5,0"/>
                    </StackPanel>
                    
                    <!-- Process List -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredProcesses}" 
                              SelectedItem="{Binding SelectedProcess}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                            <DataGridTextColumn Header="Parent PID" Binding="{Binding ParentProcessId}" Width="80"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat=N2}" Width="70"/>
                            <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryMB, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="70"/>
                            <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" Width="70"/>
                            <DataGridTextColumn Header="Ports" Binding="{Binding PortsString}" Width="120"/>
                            <DataGridTextColumn Header="Started" Binding="{Binding StartTime, StringFormat='HH:mm:ss'}" Width="90"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" Width="200"/>
                            <DataGridTextColumn Header="Command Line" Binding="{Binding CommandLine}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Kill Process" Command="{Binding KillProcessCommand}"/>
                                <MenuItem Header="Kill Process Tree" Command="{Binding KillTreeCommand}"/>
                                <MenuItem Header="Kill All with Same Name" Command="{Binding KillAllSameNameCommand}"/>
                                <Separator/>
                                <MenuItem Header="Suspend Process" Command="{Binding SuspendProcessCommand}"/>
                                <MenuItem Header="Resume Process" Command="{Binding ResumeProcessCommand}"/>
                                <Separator/>
                                <MenuItem Header="Set Priority">
                                    <MenuItem Header="Realtime" Command="{Binding SetPriorityCommand}" CommandParameter="Realtime"/>
                                    <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High"/>
                                    <MenuItem Header="Above Normal" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal"/>
                                    <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal"/>
                                    <MenuItem Header="Below Normal" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal"/>
                                    <MenuItem Header="Idle" Command="{Binding SetPriorityCommand}" CommandParameter="Idle"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Open File Location" Command="{Binding OpenFileLocationCommand}"/>
                                <MenuItem Header="Copy Details" Command="{Binding CopyDetailsCommand}"/>
                                <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Network Traffic">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Network Controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <Button Content="Start Monitoring" Command="{Binding StartNetworkMonitoringCommand}" Margin="0,0,5,0"/>
                        <Button Content="Stop Monitoring" Command="{Binding StopNetworkMonitoringCommand}" Margin="0,0,5,0"/>
                        <Button Content="Clear Log" Command="{Binding ClearNetworkLogCommand}" Margin="0,0,10,0"/>
                        <CheckBox Content="Pause" IsChecked="{Binding NetworkLogPaused}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Button Content="Export to CSV" Command="{Binding ExportNetworkLogCommand}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding NetworkStatus}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <!-- Live throughput (total + per-process) -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="5" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Total ↑ " FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalUploadRate}" Foreground="#FF6A9955" Margin="0,0,16,0"/>
                                <TextBlock Text="Total ↓ " FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalDownloadRate}" Foreground="#FF569CD6" Margin="0,0,16,0"/>
                                <TextBlock Text="Sent: " Opacity="0.7"/>
                                <TextBlock Text="{Binding TotalBytesSentDisplay}" Margin="0,0,12,0"/>
                                <TextBlock Text="Recv: " Opacity="0.7"/>
                                <TextBlock Text="{Binding TotalBytesReceivedDisplay}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding NpcapStatus}" Opacity="0.6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NetworkTrafficData}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding ProcessName}" Width="160"/>
                                                <TextBlock Text="{Binding ProcessId, StringFormat='PID {0}'}" Width="70" Opacity="0.7"/>
                                                <TextBlock Text="{Binding UploadRate, StringFormat='↑ {0}'}" Width="110" Foreground="#FF6A9955"/>
                                                <TextBlock Text="{Binding DownloadRate, StringFormat='↓ {0}'}" Width="110" Foreground="#FF569CD6"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    
                    <!-- Filter Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="200" Text="{Binding NetworkFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Filter by process, IP, port, protocol"/>
                        <Button Content="Clear" Command="{Binding ClearNetworkFilterCommand}" Margin="5,0"/>
                    </StackPanel>
                    
                    <!-- Network Log -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredNetworkEvents}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="100"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                            <DataGridTextColumn Header="Local Address" Binding="{Binding LocalAddress}" Width="150"/>
                            <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteAddress}" Width="150"/>
                            <DataGridTextColumn Header="Remote Host" Binding="{Binding RemoteHost}" Width="200"/>
                            <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size}" Width="100"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding IsAdministrator, StringFormat='Admin: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ProcessCount, StringFormat='Processes: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
